{
  "users": [
    {"name": "guest", "password": "DISABLED_GUEST_ACCOUNT_DO_NOT_USE_xyz123", "tags": ""},
    {"name": "admin", "password": "$ADMIN", "tags": "administrator"},
    {"name": "monitoring", "password": "$MONITORING", "tags": "monitoring"},
    {"name": "stream_game", "password": "$STREAM_GAME", "tags": ""},
    {"name": "validation_worker", "password": "$VALIDATION_WORKER", "tags": ""},
    {"name": "mc_gateway", "password": "$MC_GATEWAY", "tags": ""}
  ],

  "vhosts": [
    { "name": "/" },
    { "name": "/stream-game" },
    { "name": "/validation" },
    { "name": "/mc-gateway" }
  ],

  "permissions": [
    {"user": "guest", "vhost": "/", "configure": "^$", "write": "^$", "read": "^$"},
    {"user": "admin", "vhost": "/mc-gateway", "configure": ".*", "write": ".*", "read": ".*" },
    {"user": "admin", "vhost": "/stream-game", "configure": ".*", "write": ".*", "read": ".*" },
    {"user": "admin", "vhost": "/validation", "configure": ".*", "write": ".*", "read": ".*" },
    {"user": "monitoring", "vhost": "/mc-gateway", "configure": "^$", "write": "^$", "read": ".*" },
    {"user": "monitoring", "vhost": "/stream-game", "configure": "^$", "write": "^$", "read": ".*" },
    {"user": "monitoring", "vhost": "/validation", "configure": "^$", "write": "^$", "read": ".*" },
    {"user": "stream_game", "vhost": "/stream-game", "configure": "^game\\.(players|commands|events|retry|dlx)\\.*", "write": "^(amq\\.default|game\\.(players|commands|events|retry|dlx))$", "read": "^game\\.(players|commands|events|retry|dlx)\\.*" },
    {"user": "validation_worker", "vhost": "/validation", "configure": "^$", "write": "^validation\\.", "read": "^validation\\." },
    {"user": "mc_gateway", "vhost": "/mc-gateway", "configure": "^mc\\.(gateway|commands|server|retry|dlx)\\.*", "write": "^(amq\\.default|mc\\.(gateway|commands|server|retry|dlx))$", "read": "^mc\\.(gateway|commands|server|retry|dlx)\\.*" }
  ],

  "exchanges": [
    {
      "name": "dlx",
      "vhost": "/stream-game",
      "type": "direct",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "dlx",
      "vhost": "/validation",
      "type": "direct",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "dlx",
      "vhost": "/mc-gateway",
      "type": "direct",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    }
  ],

  "queues": [
    {
      "name": "stream.game.events",
      "vhost": "/stream-game",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-max-length": 100000,
        "x-overflow": "reject-publish",
        "x-dead-letter-exchange": "dlx"
      }
    },
    {
      "name": "validation.tasks",
      "vhost": "/validation",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-max-length": 50000,
        "x-overflow": "reject-publish",
        "x-dead-letter-exchange": "dlx"
      }
    },
    {
      "name": "validation.results",
      "vhost": "/validation",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-max-length": 50000,
        "x-overflow": "reject-publish",
        "x-dead-letter-exchange": "dlx"
      }
    },
    {
      "name": "mc.gateway.commands",
      "vhost": "/mc-gateway",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-max-length": 100000,
        "x-overflow": "reject-publish",
        "x-dead-letter-exchange": "dlx"
      }
    },
    {
      "name": "dlq",
      "vhost": "/stream-game",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    },
    {
      "name": "dlq",
      "vhost": "/validation",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    },
    {
      "name": "dlq",
      "vhost": "/mc-gateway",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    }
  ],

  "bindings": [
    {
      "source": "dlx",
      "vhost": "/stream-game",
      "destination": "dlq",
      "destination_type": "queue",
      "routing_key": "",
      "arguments": {}
    },
    {
      "source": "dlx",
      "vhost": "/validation",
      "destination": "dlq",
      "destination_type": "queue",
      "routing_key": "",
      "arguments": {}
    },
    {
      "source": "dlx",
      "vhost": "/mc-gateway",
      "destination": "dlq",
      "destination_type": "queue",
      "routing_key": "",
      "arguments": {}
    }
  ]
} 
